<Project>
  <!-- GetPathOfFileAbove includes the directory it starts from, so it has to
       start one level up: passing tests/ would resolve to this very file. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <!--
    Packages every test project needs, kept here so 40+ csproj files do not
    repeat them.

    CodeCoverage and HangDump are Microsoft.Testing.Platform extensions, which
    is what xunit.v3 4.x runs on. They replace the two pieces of VSTest
    infrastructure that went away with the bridge: the "XPlat Code Coverage"
    data collector and the blame-hang settings.

    Note that coverlet is NOT an option here. coverlet.collector is a VSTest
    data collector, and coverlet.msbuild never runs either: in MTP mode
    `dotnet test` hands /p: arguments to the test application rather than to
    MSBuild, so coverlet's targets are never invoked and the run silently
    produces no report.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
  </ItemGroup>
</Project>
