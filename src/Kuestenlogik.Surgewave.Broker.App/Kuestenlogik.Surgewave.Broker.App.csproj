<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Der Broker-HOST: Program.cs, REST-APIs, Startup-Wiring, eingebaute Host-Plugins
       (AutoTuning, CruiseControl, AdaptiveCompression, Cross-Topic-Transaktionen).
       Ein Host wie Control, Gateway und Marketplace: er wird gestartet, nicht
       referenziert — die Engine dahinter ist die Library Kuestenlogik.Surgewave.Broker.
       Die Typen hier behalten ihre Kuestenlogik.Surgewave.Broker.*-Namespaces aus der
       Zeit vor dem Split: Namespace beschreibt die fachliche Heimat, die Assembly die
       Auslieferung; ein Rename haette jede Test- und Programmdatei angefasst, ohne
       etwas zu verbessern. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>surgewave-broker</AssemblyName>
    <RootNamespace>Kuestenlogik.Surgewave.Broker</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Improve startup time - applies to all builds -->
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>

    <!-- Enable invariant globalization for smaller deployments -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Server GC for lower latency under load -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>true</RetainVMGarbageCollection>
    <!-- DATAS (dynamic heap-count adaptation) is ON by default for ServerGC on .NET 9/10.
         We pin it OFF to keep the full one-heap-per-core ServerGC configuration: the broker
         targets max throughput (Aeron/Kafka-competitive) plus low P99 on a dedicated box, and
         DATAS trades peak throughput / adds heap-count-ramp variance for memory adaptivity.
         Pinning here also stops a throughput-critical knob from silently flipping under a TFM
         bump, and restores the behavior all perf work (#73-#87) was validated under. Reversible:
         memory-constrained container deployments can re-enable it at deploy time via
         DOTNET_GCDynamicAdaptationMode=1 (no rebuild). See #87. -->
    <GarbageCollectionAdaptationMode>0</GarbageCollectionAdaptationMode>
  </PropertyGroup>

  <!-- Container Publishing (.NET Native) -->
  <!-- Usage: dotnet publish src/Kuestenlogik.Surgewave.Broker.App -c Release /t:PublishContainer
       Bei `dotnet publish` ohne -p:ContainerImageTag(s) wird die Project-Version
       (default 1.0.0, in CI via -p:Version=X.Y.Z gesetzt) als Tag verwendet.
       Die Release-Pipeline setzt ContainerImageTags="$V;latest" und darf
       deshalb hier KEIN ContainerImageTag finden — sonst CONTAINER2008
       ('Both ContainerImageTag and ContainerImageTags were provided'). -->
  <PropertyGroup>
    <ContainerRepository>kuestenlogik/surgewave-broker</ContainerRepository>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0</ContainerBaseImage>
    <ContainerFamily>jammy</ContainerFamily>
  </PropertyGroup>

  <ItemGroup Label="Container Ports">
    <ContainerPort Include="9092" Type="tcp" />
    <ContainerPort Include="9093" Type="tcp" />
    <ContainerPort Include="9094" Type="tcp" />
    <ContainerPort Include="9094" Type="udp" />
    <ContainerPort Include="1883" Type="tcp" />
  </ItemGroup>

  <ItemGroup Label="Container Environment">
    <ContainerEnvironmentVariable Include="DOTNET_RUNNING_IN_CONTAINER" Value="true" />
    <ContainerEnvironmentVariable Include="Surgewave__Storage__DataDirectory" Value="/app/data" />
    <ContainerEnvironmentVariable Include="Surgewave__Storage__LogDirectory" Value="/app/logs" />
  </ItemGroup>

  <!-- Publish-specific settings for optimized builds -->
  <!-- Use: dotnet publish -c Release -p:Optimized=true -r win-x64 -->
  <!-- Optional protocols need no single-file exclusion any more (#61): this project does not
       reference them, so they never enter the bundle in the first place. They are published as
       .swpkg packages and installed into plugins/<id>/ next to the executable, which single-file
       publishing does not touch — BrokerPluginActivator loads them from there via their manifest.
       Kuestenlogik.Surgewave.Protocol.Native stays bundled as it is part of the broker core. -->
  <PropertyGroup Condition="'$(Optimized)' == 'true'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <ReadyToRun>true</ReadyToRun>
    <!-- Optimize for speed -->
    <OptimizationPreference>Speed</OptimizationPreference>
    <DebuggerSupport>false</DebuggerSupport>
    <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <!-- No trimming — Broker uses extensive Reflection (plugin loading, JSON, gRPC, dynamic config) -->
  </PropertyGroup>

  <!-- Native AOT - experimental, may not work with all dependencies -->
  <!-- Use: dotnet publish -c Release -p:PublishAot=true -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <SelfContained>true</SelfContained>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Speed</OptimizationPreference>
    <!-- AOT-specific trimming -->
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kuestenlogik.Surgewave.Broker.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" />
    <PackageReference Include="Microsoft.AspNetCore.Grpc.JsonTranscoding" />
    <!-- ExcludeAssets=contentFiles: Bowire liefert bowire.js zusaetzlich als
         contentFile in die wwwroot des Konsumenten — der Broker braucht das
         nicht (Bowire serviert die Tap-UI zur Laufzeit aus EmbeddedResources)
         und wuerde die Datei sonst als Static-Web-Asset mitverpacken. -->
    <PackageReference Include="Kuestenlogik.Bowire" ExcludeAssets="contentFiles" />
    <!-- surgewave://-Protokoll fuer den /bowire-Browser (inkl. embedded-Tap).
         Wird von BowireProtocolRegistry per Assembly-Scan entdeckt; die
         Surgewave.Client-Abhaengigkeit des Pakets wird durch die lokale
         ProjectReference ersetzt. -->
    <PackageReference Include="Kuestenlogik.Bowire.Protocol.Surgewave" ExcludeAssets="contentFiles" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="OpenTelemetry" />
    <!-- VersionOverride statt zentralem Pin: der Exporter existiert upstream nur als -beta, und ein
         zentraler Eintrag wuerde via CentralPackageTransitivePinning in die nuspec jedes packbaren
         Downstream-Projekts promotet (NU5104 beim stabilen Release-Pack). -->
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" VersionOverride="1.15.3-beta.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Broker\Kuestenlogik.Surgewave.Broker.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Api.Grpc.Server\Kuestenlogik.Surgewave.Api.Grpc.Server.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Cdc.Hosting\Kuestenlogik.Surgewave.Cdc.Hosting.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Connect.Hosting\Kuestenlogik.Surgewave.Connect.Hosting.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Plugins.Packaging.Hosting\Kuestenlogik.Surgewave.Plugins.Packaging.Hosting.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Schema.Registry.Handlers.Avro\Kuestenlogik.Surgewave.Schema.Registry.Handlers.Avro.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Schema.Registry.Handlers.FlatBuffers\Kuestenlogik.Surgewave.Schema.Registry.Handlers.FlatBuffers.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Schema.Registry.Handlers.Json\Kuestenlogik.Surgewave.Schema.Registry.Handlers.Json.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Schema.Registry.Handlers.Protobuf\Kuestenlogik.Surgewave.Schema.Registry.Handlers.Protobuf.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Schema.Registry.Hosting\Kuestenlogik.Surgewave.Schema.Registry.Hosting.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Storage.Engine\Kuestenlogik.Surgewave.Storage.Engine.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Storage.Engine.FileSystem\Kuestenlogik.Surgewave.Storage.Engine.FileSystem.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Storage.Engine.Memory\Kuestenlogik.Surgewave.Storage.Engine.Memory.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Storage.Tiering\Kuestenlogik.Surgewave.Storage.Tiering.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Streams\Kuestenlogik.Surgewave.Streams.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Streams.InteractiveQueries\Kuestenlogik.Surgewave.Streams.InteractiveQueries.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Streams.InteractiveQueries.Hosting\Kuestenlogik.Surgewave.Streams.InteractiveQueries.Hosting.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Transport\Kuestenlogik.Surgewave.Transport.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Transport.Quic\Kuestenlogik.Surgewave.Transport.Quic.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Transport.Tcp\Kuestenlogik.Surgewave.Transport.Tcp.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Wasm.Hosting\Kuestenlogik.Surgewave.Wasm.Hosting.csproj" />
  </ItemGroup>

</Project>
