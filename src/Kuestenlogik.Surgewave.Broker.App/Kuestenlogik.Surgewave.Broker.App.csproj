<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The broker HOST: Program.cs, REST APIs, startup wiring, built-in host plugins
       (AutoTuning, CruiseControl, AdaptiveCompression, cross-topic transactions).
       A host like Control, Gateway and Marketplace: it is started, not
       referenced — the engine behind it is the library Kuestenlogik.Surgewave.Broker.
       The types here keep their Kuestenlogik.Surgewave.Broker.* namespaces from the
       time before the split: the namespace describes the functional home, the assembly the
       delivery; a rename would have touched every test and program file without
       improving anything. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AssemblyName>surgewave-broker</AssemblyName>
    <RootNamespace>Kuestenlogik.Surgewave.Broker</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Improve startup time - applies to all builds -->
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>

    <!-- Enable invariant globalization for smaller deployments -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Server GC for lower latency under load -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>true</RetainVMGarbageCollection>
    <!-- DATAS (dynamic heap-count adaptation) is ON by default for ServerGC on .NET 9/10.
         We pin it OFF to keep the full one-heap-per-core ServerGC configuration: the broker
         targets max throughput (Aeron/Kafka-competitive) plus low P99 on a dedicated box, and
         DATAS trades peak throughput / adds heap-count-ramp variance for memory adaptivity.
         Pinning here also stops a throughput-critical knob from silently flipping under a TFM
         bump, and restores the behavior all perf work (#73-#87) was validated under. Reversible:
         memory-constrained container deployments can re-enable it at deploy time via
         DOTNET_GCDynamicAdaptationMode=1 (no rebuild). See #87. -->
    <GarbageCollectionAdaptationMode>0</GarbageCollectionAdaptationMode>
  </PropertyGroup>

  <!-- Container Publishing (.NET Native) -->
  <!-- Usage: dotnet publish src/Kuestenlogik.Surgewave.Broker.App -c Release /t:PublishContainer
       With `dotnet publish` without -p:ContainerImageTag(s) the project version
       (default 1.0.0, set in CI via -p:Version=X.Y.Z) is used as the tag.
       The release pipeline sets ContainerImageTags="$V;latest" and must
       therefore find NO ContainerImageTag here — otherwise CONTAINER2008
       ('Both ContainerImageTag and ContainerImageTags were provided'). -->
  <PropertyGroup>
    <ContainerRepository>kuestenlogik/surgewave-broker</ContainerRepository>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0</ContainerBaseImage>
    <ContainerFamily>jammy</ContainerFamily>
    <!-- The unprivileged user of the .NET images (APP_UID), named here and not left to the base image's USER:
         only with a numeric ContainerUser does the SDK give the application layer to that user, and only a
         directory the user owns in the image is writable on a fresh named volume, which Docker creates with
         the owner of the directory it is mounted on (#269). -->
    <ContainerUser>1654</ContainerUser>
  </PropertyGroup>

  <!-- A multi-architecture publish (release.yml: ContainerRuntimeIdentifiers="linux-x64;linux-arm64") builds this
       project once per architecture, by default at the same time, and Directory.Build.props gives every build of
       a project the same obj, bin and publish directory whatever its runtime: the two builds wrote the same
       files ("surgewave-broker.deps.json ... is being used by another process", MSB4018) and each image was
       made from the one publish directory both had filled - the linux-arm64 image built here held the x86-64
       libe_sqlite3.so and libwasmtime.so (#269). They run one after the other, and each in directories of its own. -->
  <PropertyGroup>
    <ContainerPublishInParallel>false</ContainerPublishInParallel>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ContainerRuntimeIdentifier)' != ''">
    <IntermediateOutputPath>$(IntermediateOutputPath)$(ContainerRuntimeIdentifier)\</IntermediateOutputPath>
    <OutputPath>$(OutputPath)$(ContainerRuntimeIdentifier)\</OutputPath>
    <PublishDir>$(PublishDir)$(ContainerRuntimeIdentifier)\</PublishDir>
  </PropertyGroup>

  <ItemGroup Label="Container Ports">
    <ContainerPort Include="9092" Type="tcp" />
    <ContainerPort Include="9093" Type="tcp" />
    <ContainerPort Include="9094" Type="tcp" />
    <ContainerPort Include="9094" Type="udp" />
    <ContainerPort Include="1883" Type="tcp" />
  </ItemGroup>

  <ItemGroup Label="Container Environment">
    <ContainerEnvironmentVariable Include="DOTNET_RUNNING_IN_CONTAINER" Value="true" />
    <!-- gRPC, REST, /health and /metrics in cleartext (#269). appsettings.json binds both endpoints over HTTPS
         with the ASP.NET Core development certificate, which a workstation has and an image does not: the
         broker ended with "Unable to configure HTTPS endpoint". The second endpoint is HTTP/3, which needs
         TLS, so it stays on loopback without it. With a certificate: Surgewave__GrpcUseTls=true and
         Surgewave__GrpcCertificatePath, see docs/deployment/tls.md. The broker says at startup which it is. -->
    <ContainerEnvironmentVariable Include="Surgewave__GrpcUseTls" Value="false" />
    <ContainerEnvironmentVariable Include="Kestrel__Endpoints__Grpc__Url" Value="http://*:9093" />
    <ContainerEnvironmentVariable Include="Kestrel__Endpoints__GrpcHttp3__Url" Value="http://localhost:9094" />
    <ContainerEnvironmentVariable Include="Kestrel__Endpoints__GrpcHttp3__Protocols" Value="Http1AndHttp2" />
  </ItemGroup>

  <!-- The SDK hands the image's environment variables to the per-architecture builds of a multi-architecture
       publish as name:value and takes them apart again at every colon (_ParseItemsForPublishingSingleContainer in
       Microsoft.NET.Build.Containers.targets), which cut "http://*:9093" down to "http": the image built as
       release.yml builds it, for linux-x64 and linux-arm64, ended with "Invalid url: 'http'". The items declared
       above are whole in those builds as well, so they replace what was taken apart, and a build whose image
       would not carry every one of them as declared fails. -->
  <Target Name="RestoreContainerEnvironmentVariables" BeforeTargets="_PublishSingleContainer">
    <ItemGroup>
      <ContainerEnvironmentVariables Remove="@(ContainerEnvironmentVariable)" />
      <ContainerEnvironmentVariables Include="@(ContainerEnvironmentVariable)" />
      <_DeclaredContainerEnvironment Include="@(ContainerEnvironmentVariable->'%(Identity)=%(Value)')" />
      <_ImageContainerEnvironment Include="@(ContainerEnvironmentVariables->'%(Identity)=%(Value)')" />
      <_LostContainerEnvironment Include="@(_DeclaredContainerEnvironment)" Exclude="@(_ImageContainerEnvironment)" />
    </ItemGroup>
    <Error Text="The container image would not carry these environment variables as declared: @(_LostContainerEnvironment, ', ')."
           Condition="'@(_LostContainerEnvironment)' != ''" />
  </Target>

  <!-- The directories the broker writes to, in the image and owned by its user (#269): appsettings.json names
       ./data and ./logs, the image's working directory is /app, the metadata log is data/raft and plugins an
       operator installs are read from data/plugins. A named volume mounted on one of them takes its owner
       from the image; mounted on a path the image does not hold it belongs to root, and the broker ended with
       "Access to the path '/app/data' is denied". -->
  <Target Name="CreateContainerDataDirectories" BeforeTargets="_PublishSingleContainer">
    <MakeDir Directories="$(PublishDir)data/raft;$(PublishDir)data/plugins;$(PublishDir)logs" />
  </Target>

  <!-- Publish-specific settings for optimized builds -->
  <!-- Use: dotnet publish -c Release -p:Optimized=true -r win-x64 -->
  <!-- Optional protocols need no single-file exclusion any more (#61): this project does not
       reference them, so they never enter the bundle in the first place. They are published as
       .swpkg packages and installed into plugins/<id>/ next to the executable, which single-file
       publishing does not touch — BrokerPluginActivator loads them from there via their manifest.
       Kuestenlogik.Surgewave.Protocol.Native stays bundled as it is part of the broker core. -->
  <PropertyGroup Condition="'$(Optimized)' == 'true'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <ReadyToRun>true</ReadyToRun>
    <!-- Optimize for speed -->
    <OptimizationPreference>Speed</OptimizationPreference>
    <DebuggerSupport>false</DebuggerSupport>
    <EnableUnsafeUTF7Encoding>false</EnableUnsafeUTF7Encoding>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <!-- No trimming — Broker uses extensive Reflection (plugin loading, JSON, gRPC, dynamic config) -->
  </PropertyGroup>

  <!-- Native AOT - experimental, may not work with all dependencies -->
  <!-- Use: dotnet publish -c Release -p:PublishAot=true -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <SelfContained>true</SelfContained>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Speed</OptimizationPreference>
    <!-- AOT-specific trimming -->
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kuestenlogik.Surgewave.Broker.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" />
    <PackageReference Include="Microsoft.AspNetCore.Grpc.JsonTranscoding" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="OpenTelemetry" />
    <!-- VersionOverride instead of a central pin: upstream the exporter only exists as -beta, and a
         central entry would be promoted via CentralPackageTransitivePinning into the nuspec of every packable
         downstream project (NU5104 on the stable release pack). -->
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" VersionOverride="1.15.3-beta.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Broker\Kuestenlogik.Surgewave.Broker.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Api.Grpc.Server\Kuestenlogik.Surgewave.Api.Grpc.Server.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Cdc.Hosting\Kuestenlogik.Surgewave.Cdc.Hosting.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Connect.Hosting\Kuestenlogik.Surgewave.Connect.Hosting.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Plugins.Packaging.Hosting\Kuestenlogik.Surgewave.Plugins.Packaging.Hosting.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Schema.Registry.Handlers.Avro\Kuestenlogik.Surgewave.Schema.Registry.Handlers.Avro.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Schema.Registry.Handlers.FlatBuffers\Kuestenlogik.Surgewave.Schema.Registry.Handlers.FlatBuffers.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Schema.Registry.Handlers.Json\Kuestenlogik.Surgewave.Schema.Registry.Handlers.Json.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Schema.Registry.Handlers.Protobuf\Kuestenlogik.Surgewave.Schema.Registry.Handlers.Protobuf.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Schema.Registry.Hosting\Kuestenlogik.Surgewave.Schema.Registry.Hosting.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Storage.Engine\Kuestenlogik.Surgewave.Storage.Engine.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Storage.Engine.FileSystem\Kuestenlogik.Surgewave.Storage.Engine.FileSystem.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Storage.Engine.Memory\Kuestenlogik.Surgewave.Storage.Engine.Memory.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Storage.Tiering\Kuestenlogik.Surgewave.Storage.Tiering.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Streams\Kuestenlogik.Surgewave.Streams.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Streams.InteractiveQueries\Kuestenlogik.Surgewave.Streams.InteractiveQueries.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Streams.InteractiveQueries.Hosting\Kuestenlogik.Surgewave.Streams.InteractiveQueries.Hosting.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Transport\Kuestenlogik.Surgewave.Transport.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Transport.Quic\Kuestenlogik.Surgewave.Transport.Quic.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Transport.Tcp\Kuestenlogik.Surgewave.Transport.Tcp.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Wasm.Hosting\Kuestenlogik.Surgewave.Wasm.Hosting.csproj" />
    <!-- Build order only: the Kafka protocol plugin is built before the broker so CopyKafkaPluginForDevRun
         (Directory.Build.targets) can stage it for a dev run. No assembly reference, nothing copied, nothing in
         the broker's deps.json — the broker stays Kafka-free (#59). -->
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Protocol.Kafka\Kuestenlogik.Surgewave.Protocol.Kafka.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

</Project>
