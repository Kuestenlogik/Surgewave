<Project Sdk="Microsoft.NET.Sdk">

  <!-- Die Broker-ENGINE als Library: Topics, Partitionen, Koordinatoren (Groups/
       Transaktionen/Queues/Shares), Quota, Dedup, TTL/Delay, native Control-Plane.
       Alles, was hier lebt, ist framework-frei (kein ASP.NET, kein OTel, kein gRPC) —
       das ist die Grenze zu Kuestenlogik.Surgewave.Broker.App, dem Exe-Host mit
       Program.cs, REST-APIs und Startup-Wiring. Runtime (embedded) und Hosting
       referenzieren NUR diese Library; niemand referenziert das Exe.
       Neue Datei hier? Nur wenn sie ohne Host-Frameworks auskommt — eine REST-API
       oder ein BackgroundService gehört in Broker.App. -->
  <PropertyGroup>
    <Description>Surgewave broker engine - topics, partitions, coordinators, quotas. Reference this to embed the broker; the runnable server is the surgewave-broker host.</Description>
    <PackageTags>surgewave;kafka;streaming;broker;engine;embedded</PackageTags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kuestenlogik.Surgewave.Broker.Tests" />
    <!-- Der Host war bis zum Split dieselbe Assembly und nutzt interne Engine-Typen. -->
    <InternalsVisibleTo Include="surgewave-broker" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Api.GraphQL\Kuestenlogik.Surgewave.Api.GraphQL.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Broker.Abstractions\Kuestenlogik.Surgewave.Broker.Abstractions.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Clustering\Kuestenlogik.Surgewave.Clustering.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Connect\Kuestenlogik.Surgewave.Connect.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Coordination\Kuestenlogik.Surgewave.Coordination.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Core\Kuestenlogik.Surgewave.Core.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Plugins.Repository\Kuestenlogik.Surgewave.Plugins.Repository.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Protocol.Native\Kuestenlogik.Surgewave.Protocol.Native.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Schema.Registry\Kuestenlogik.Surgewave.Schema.Registry.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Storage.Disaggregated\Kuestenlogik.Surgewave.Storage.Disaggregated.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Surgewave.Wasm\Kuestenlogik.Surgewave.Wasm.csproj" />
  </ItemGroup>

</Project>
