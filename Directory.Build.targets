<Project>
  <!-- Packing is NOT part of building. Opt in per invocation with -p:PackOnBuild=true.

       Every place that actually wants packages already asks for them explicitly, and passes the
       no-build switch, so it only needs the build OUTPUT and never a build that also packed:
         .github/workflows/ci.yml       (dotnet pack, no-build)
         .github/workflows/release.yml  (dotnet pack, no-build)
         scripts/build.ps1              (dotnet build, then dotnet pack with no-build)

       Leaving GeneratePackageOnBuild on made every build in the repo pack a .nupkg for each of
       ~40 packable projects: the inner loop, every `dotnet test` (which builds its references),
       every IDE build, and any FOREIGN build we do not control.

       Measured on the benchmark project's closure, no-incremental Release:
         PackOnBuild=true   125.2 s
         PackOnBuild=false   88.1 s
       Per project the cost is inside the noise, which is why it went unnoticed; across the
       closure it is ~30 %. It also decided a threshold: BenchmarkDotNet compiles a generated
       project referencing the benchmark assembly under a 120 s build budget, and 125 > 120 > 88.
       Local benchmarking was impossible repo-wide, with nothing but an empty "Build Error" to
       show for it (the real reason only appears in the BDN log file).

       It also couples compiling to packaging: a metadata-only problem (bad version, missing icon)
       fails a plain `dotnet build` even though the code compiles. See the SemVer note in ci.yml's
       "Determine version" step for a case that already cost time.

       Matches the sibling repos. Bowire does not set this property at all and packs explicitly in
       ci.yml:145 and release.yml:168. -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false' AND '$(PackOnBuild)' == 'true'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- Coverage fix: while instrumenting, Coverlet/Cecil has to resolve the custom attribute
       signatures; the [LoggerMessage] attributes carry LogLevel enum
       arguments from Microsoft.Extensions.Logging.Abstractions. Without the
       compilation context references in the deps.json, Cecil throws an
       AssemblyResolutionException on the Linux runner and Coverlet SKIPS exactly the
       logging-heavy modules — Core/Clustering/Protocol.Kafka therefore stood
       uniformly at 0 % coverage (Coverlet's documented fix for
       CecilAssemblyResolutionException). Evaluated in targets, so that IsTestProject
       from the csproj is already resolved. -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <PreserveCompilationContext>true</PreserveCompilationContext>
  </PropertyGroup>

  <!-- Microsoft.Testing.Platform extensions that every test project needs:
       CodeCoverage replaces the "XPlat Code Coverage" data collector, HangDump
       the former blame-hang options. Both MUST be here and not
       in tests/Directory.Build.props: the four sample test projects live under
       samples/<Sample>/tests/ and only see this file. Without the HangDump extension
       a module rejects the hangdump option and reports "Zero tests ran" -
       the test run then fails without any test failing.
       In targets, so that IsTestProject from the csproj is resolved. -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
  </ItemGroup>

  <!-- Only projects that are actually measured get the coverage extension. coverage.yml
       takes IntegrationTests out of the coverage solution; the project
       therefore sets ExcludeFromCoverage and thereby also stays free of
       instrumentation. -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true' AND '$(ExcludeFromCoverage)' != 'true'">
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <!--
    Surgewave Plugin Package Creation Target
    Usage: dotnet build -p:CreateSurgewavePackage=true
  -->

  <PropertyGroup>
    <!-- Enable with -p:CreateSurgewavePackage=true -->
    <CreateSurgewavePackage>false</CreateSurgewavePackage>
    <!-- Output directory for .surgewavepackage files -->
    <SurgewavePackageOutputDir>$(ArtifactsPath)pkg\</SurgewavePackageOutputDir>
  </PropertyGroup>

  <!--
    Create .surgewavepackage after build for connector projects
    Only runs when:
    - CreateSurgewavePackage is true
    - Project name starts with Kuestenlogik.Surgewave.Connector.
    - Project is not a test project
  -->
  <Target Name="CreateSurgewavePackage"
          AfterTargets="Build"
          Condition="'$(CreateSurgewavePackage)' == 'true' AND
                     $(MSBuildProjectName.StartsWith('Kuestenlogik.Surgewave.Connector.')) AND
                     !$(MSBuildProjectName.EndsWith('.Tests'))">

    <PropertyGroup>
      <!-- Connector assembly paths -->
      <_ConnectorDll>$(OutputPath)$(AssemblyName).dll</_ConnectorDll>
      <_ConnectorDeps>$(OutputPath)$(AssemblyName).deps.json</_ConnectorDeps>
      <_PackageName>$(AssemblyName)-$(Version).surgewavepackage</_PackageName>
      <_PackagePath>$(SurgewavePackageOutputDir)$(_PackageName)</_PackagePath>
      <_TempPackageDir>$(IntermediateOutputPath)surgewavepackage\</_TempPackageDir>
    </PropertyGroup>

    <!-- Create temp directories -->
    <MakeDir Directories="$(SurgewavePackageOutputDir)" Condition="!Exists('$(SurgewavePackageOutputDir)')" />
    <MakeDir Directories="$(_TempPackageDir)" />
    <MakeDir Directories="$(_TempPackageDir)lib" />
    <MakeDir Directories="$(_TempPackageDir)deps" />

    <!-- Copy main connector DLL to lib/ -->
    <Copy SourceFiles="$(_ConnectorDll)"
          DestinationFolder="$(_TempPackageDir)lib"
          SkipUnchangedFiles="false" />

    <!-- Copy deps.json to lib/ if exists -->
    <Copy SourceFiles="$(_ConnectorDeps)"
          DestinationFolder="$(_TempPackageDir)lib"
          SkipUnchangedFiles="false"
          Condition="Exists('$(_ConnectorDeps)')" />

    <!-- Find and copy external dependencies (non-Kuestenlogik.Surgewave DLLs) -->
    <ItemGroup>
      <_AllDlls Include="$(OutputPath)*.dll" />
      <_ExternalDeps Include="@(_AllDlls)"
                     Condition="!$([System.String]::Copy('%(Filename)').StartsWith('Kuestenlogik.Surgewave.'))" />
    </ItemGroup>

    <Copy SourceFiles="@(_ExternalDeps)"
          DestinationFolder="$(_TempPackageDir)deps"
          SkipUnchangedFiles="false" />

    <!-- Generate plugin.json manifest with extended metadata fields -->
    <PropertyGroup>
      <_ConnectorDisplayName>$(AssemblyName.Replace('Kuestenlogik.Surgewave.Connector.', '').Replace('.', ' '))</_ConnectorDisplayName>
      <_ConnectorDescription>$(Description)</_ConnectorDescription>
      <_ConnectorCategory Condition="'$(PackageTags)' != ''">Integration</_ConnectorCategory>
      <_ConnectorCategory Condition="'$(_ConnectorCategory)' == ''">Integration</_ConnectorCategory>
      <_ManifestContent>
{
  "id": "$(AssemblyName)",
  "name": "$(_ConnectorDisplayName)",
  "version": "$(Version)",
  "description": "$(_ConnectorDescription)",
  "authors": ["$(Authors)"],
  "license": "$(PackageLicenseExpression)",
  "connectors": []
}
      </_ManifestContent>
    </PropertyGroup>

    <WriteLinesToFile File="$(_TempPackageDir)plugin.json"
                      Lines="$(_ManifestContent)"
                      Overwrite="true" />

    <!-- Copy README.md if exists -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\README.md"
          DestinationFolder="$(_TempPackageDir)"
          SkipUnchangedFiles="false"
          Condition="Exists('$(MSBuildProjectDirectory)\README.md')" />

    <!-- Copy LICENSE if exists -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\LICENSE"
          DestinationFolder="$(_TempPackageDir)"
          SkipUnchangedFiles="false"
          Condition="Exists('$(MSBuildProjectDirectory)\LICENSE')" />

    <!-- Delete existing package if present -->
    <Delete Files="$(_PackagePath)" Condition="Exists('$(_PackagePath)')" />

    <!-- Create ZIP archive -->
    <ZipDirectory SourceDirectory="$(_TempPackageDir)"
                  DestinationFile="$(_PackagePath)"
                  Overwrite="true" />

    <!-- Clean up temp directory -->
    <RemoveDir Directories="$(_TempPackageDir)" />

    <Message Text="Created Surgewave package: $(_PackagePath)" Importance="high" />
  </Target>

  <!--
    #59 b6 — dev-mode Kafka plugin discovery.
    The broker does not reference Protocol.Kafka (#59): the Kafka wire protocol is a plugin, and a
    published broker gets it as a .swpkg (scripts/publish.ps1). Run from source (`dotnet run`, F5), the
    broker would therefore run native-only and close every Kafka client. This stages the built plugin into
    the broker's plugins/ folder in the layout the installer produces — plugins/<plugin id>/ with the
    assembly, its manifest and deps, and its private external dependencies — so a dev run speaks Kafka.

    Only the broker host (Broker.App) gets it: its Installation scope is <exe dir>/plugins. The plugin's
    own copies of the host's Kuestenlogik.Surgewave.* assemblies stay out, or the plugin would load a second
    copy of the types it shares with the host. Broker.App's build-order ProjectReference to Protocol.Kafka
    (ReferenceOutputAssembly=false) makes sure the plugin is built first; the broker stays Kafka-free,
    which Broker.BootTests' KafkaFreeBrokerTests holds.
  -->
  <Target Name="CopyKafkaPluginForDevRun"
          AfterTargets="Build"
          Condition="'$(MSBuildProjectName)' == 'Kuestenlogik.Surgewave.Broker.App'">
    <PropertyGroup>
      <_KafkaPluginId>kuestenlogik.surgewave.protocol.kafka</_KafkaPluginId>
      <_KafkaPluginOut>$(ArtifactsPath)bin\Kuestenlogik.Surgewave.Protocol.Kafka\$(Configuration)\</_KafkaPluginOut>
      <_KafkaPluginDir>$(OutputPath)plugins\$(_KafkaPluginId)\</_KafkaPluginDir>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(_KafkaPluginOut)Kuestenlogik.Surgewave.Protocol.Kafka.dll')">
      <_KafkaPluginFiles Include="$(_KafkaPluginOut)Kuestenlogik.Surgewave.Protocol.Kafka.dll" />
      <_KafkaPluginFiles Include="$(_KafkaPluginOut)Kuestenlogik.Surgewave.Protocol.Kafka.deps.json" Condition="Exists('$(_KafkaPluginOut)Kuestenlogik.Surgewave.Protocol.Kafka.deps.json')" />
      <_KafkaPluginFiles Include="$(_KafkaPluginOut)plugin.json" Condition="Exists('$(_KafkaPluginOut)plugin.json')" />
      <!-- The plugin's private external dependencies, without the host's shared assemblies. -->
      <_KafkaPluginFiles Include="$(_KafkaPluginOut)*.dll" Exclude="$(_KafkaPluginOut)Kuestenlogik.Surgewave.*.dll" />
    </ItemGroup>
    <Warning Text="CopyKafkaPluginForDevRun: no Kafka plugin build output at $(_KafkaPluginOut) — the broker runs native-only."
             Condition="'@(_KafkaPluginFiles)' == ''" />
    <Copy SourceFiles="@(_KafkaPluginFiles)"
          DestinationFolder="$(_KafkaPluginDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_KafkaPluginFiles)' != ''" />
    <Message Text="#59 b6: staged the Kafka plugin into $(_KafkaPluginDir) for dev-run"
             Importance="normal"
             Condition="'@(_KafkaPluginFiles)' != ''" />
  </Target>

</Project>
